PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Add your current public IP under Atlas -> Network Access (Database -> Network Access -> Add IP Address)
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/resqnet_db

# Connection resilience (optional)
MONGO_CONNECT_RETRIES=3
MONGO_RETRY_DELAY_MS=2000
MONGO_SELECTION_TIMEOUT_MS=10000
# Atlas SRV records sometimes fail on ISP/router DNS. Public resolvers are used by default.
# Set to "system" to use your operating system DNS servers instead.
DNS_SERVERS=8.8.8.8,1.1.1.1
# Set to true only if you need the API to boot without a database (health check will report degraded)
ALLOW_NO_DB=false

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CLIENT_URL=*
