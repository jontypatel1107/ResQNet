{
  "expo": {
    "name": "ResQNet",
    "slug": "resqnet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resqnet",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resqnet.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Allow ResQNet to access your contacts to easily add emergency contacts to your trusted circle.",
        "LSApplicationQueriesSchemes": ["sms", "tel"]
      }
    },
    "android": {
      "package": "com.resqnet.app",
      "adaptiveIcon": {
        "backgroundColor": "#14283F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "sms" },
            { "scheme": "tel" }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications",
      "expo-splash-screen",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow ResQNet to access your contacts to easily add emergency contacts to your trusted circle."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
